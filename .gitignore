# Root-level ignores for the monorepo.

# Node (frontend, backend/user-service)
node_modules/
dist/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Go (backend/court-service, backend/booking-service)
bin/
*.exe
*.test

# Next.js (frontend)
frontend/.next/
frontend/out/
frontend/build/
frontend/next-env.d.ts

# testing
coverage/

# typescript
*.tsbuildinfo

# vercel
.vercel

# env files (opt-in per service via .env.example)
.env
.env.*
!.env.example

# certificates
*.pem

# debug / logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editors / OS
.DS_Store
