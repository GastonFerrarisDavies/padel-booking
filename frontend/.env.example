# Copiar a .env.local. Las variables NEXT_PUBLIC_* se inyectan en BUILD TIME (output: 'export').

# URL base del backend. Default: "/api" (mismo origen, detrás de un reverse proxy).
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# "true" => api/utils.jsx responde con datos en memoria (api/mock.js) sin backend.
# Credenciales demo: admin@padel.com / admin123 (rol OWNER)
NEXT_PUBLIC_API_MOCK=true
