PORT=3000

DB_HOST=user-db
DB_PORT=3306
DB_USER=user_service
DB_PASSWORD=changeme
DB_DATABASE=user_service_db
# DB_POOL_SIZE=10

# Clerk (https://dashboard.clerk.com → API keys). Authentication lives in Clerk;
# roles/active flags live in the user_roles table of this service.
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Optional: comma-separated frontend origins accepted as the token's `azp` claim.
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://padel.example.com

# Optional: the Clerk account with this (verified) primary email becomes OWNER
# on its first sign-in, as long as no OWNER exists yet.
# OWNER_EMAIL=owner@example.com
